---
interface Props {
   price: string;
   title: string;
}

const { title, price } = Astro.props;

const getPrice = (price: string) => {
   return price == '-' ? 'Tidak Tersedia' : price === 'cu' ? 'Hubungi Kami' : `Rp ${price}`;
};
---

<div class='container border border-2 border-primary rounded d-flex flex-column justify-content-between py-0'>
   <h2 class='text-center fs-4 fw-bold border-bottom border-primary border-2 py-2' set:html={title} />
   <div class='my-4 d-flex flex-column gap-2'>
      <p class='text-center fw-bold'>Mulai Dari :</p>
      <h3 class='text-center text-danger fs-1 fw-bold'>{getPrice(price)}</h3>

      <p class='text-danger text-center fst-italic font-monospace fs-6 m-0 p-0'>
         **Harga dapat berubah sewaktu-waktu & tergantung lokasi pengiriman
      </p>
   </div>
</div>
