---
interface Props {
   price: string;
   title: string;
}

const { title, price } = Astro.props;
---

<div class='container border border-2 border-primary rounded d-flex flex-column justify-content-between py-0'>
   <h2 class='text-center fs-4 fw-bold border-bottom border-primary border-2 py-2'>{title}</h2>
   <h3 class='text-center text-danger fs-1 fw-bold py-2'>Rp {price}</h3>
</div>
