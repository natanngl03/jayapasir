---
import Card from './Card.astro';
import BatuData from './../../data/batuNew.json';

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/products/*.{jpg,jpeg,png,webp}', {
   eager: true,
});

function getImage(name: string) {
   return images[`../../assets/img/products/${name}`]?.default;
}
---

<div class='row g-2'>
   {
      BatuData &&
         BatuData.map((val, idx) => {
            const img = getImage(val.image);

            return (
               <div class='col-6 col-lg-3'>
                  <Card
                     imgSrc={`/img/${val.image}`}
                     alt={`batu_${idx}`}
                     gallery='batu_gallery'
                     title={val.title}
                     page={val.params.product}
                  />
               </div>
            );
         })
   }
</div>
