---
import { Image } from 'astro:assets';

interface Props {
   img: ImageMetadata;
   alt: string;
   gallery: string;
   title: string;
   page: string;
}

const { img, alt, gallery, title, page } = Astro.props;
---

<div class='card shadow'>
   <a href={img?.src} class='glightbox' data-gallery={gallery}>
      <Image
         src={img}
         alt={alt}
         layout='constrained'
         style={{
            width: '100%',
            height: '300px',
            borderRadius: '10px',
         }}
         quality='low'
         loading='lazy'
         class='card-img-top cardimg'
      />
   </a>
   <div class='card-body'>
      <h6 class='card-title text-center mb-3'>{title}</h6>
      <a
         href={`/product/${page}`}
         class='btn btn-primary text-white d-flex align-items-center justify-content-center gap-2'
      >
         <i class='fas fa-long-arrow-alt-right'></i>
         <span>Cek Harga</span>
      </a>
   </div>
</div>
