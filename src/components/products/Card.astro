---
import { Icon } from 'astro-icon/components';
interface Props {
   imgSrc: string;
   alt: string;
   gallery: string;
   title: string;
   page: string;
}

const { imgSrc, alt, gallery, title, page } = Astro.props;
---

<div class='card shadow'>
   <a href={imgSrc} class='glightbox' data-gallery={gallery}>
      <img src={imgSrc} alt={title} class='card-img-top cardimg' loading='lazy' width='100%' height='250px' />
   </a>
   <div class='card-body'>
      <h6 class='card-title text-center mb-3'>{title}</h6>
      <a
         href={`/product/${page}`}
         class='btn btn-primary text-white d-flex align-items-center justify-content-center gap-2'
      >
         <span>Cek Harga</span>

         <Icon name='fa6-solid:arrow-right-long' class='text-white' size={20} />
      </a>
   </div>
</div>
