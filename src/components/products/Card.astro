---
import Modal from './Modal.astro';
export interface CardProps {
   title: string;
   imgAlt: string;
}

interface Props extends CardProps {
   type: 'pasir' | 'batu';
}

const { title, imgAlt, type } = Astro.props;

const imgSrc = type == 'pasir' ? `/img/pasir/${imgAlt}.webp` : `/img/batu/${imgAlt}.webp`;
---

<div class='card shadow'>
   <a href={`/product/${imgAlt}`}>
      <img src={imgSrc} class='card-img-top cardimg' alt={imgAlt} />
   </a>
   <div class='card-body'>
      <h6 class='card-title text-center mb-3'>{title}</h6>
      <a href={`/product/${imgAlt}`} class='btn btn-primary text-white d-flex align-items-center justify-content-center gap-2'>
         <i class='fas fa-long-arrow-alt-right'></i>
         <span>Cek Harga</span>
      </a>
   </div>
</div>

<Modal />

<style>
   .cardimg {
      width: 100%;
      height: 180px;
   }
   .card {
      border-radius: 10px;
      overflow: hidden;
   }

   .card-body span {
      /* font-size: 12px; */
   }

   .btn {
      width: 100%;
      /* border-radius: 20px; */
   }
</style>
