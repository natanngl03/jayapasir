---
import Card from './Card.astro';
import PasirData from './../../data/pasirNew.json';
import BatuData from './../../data/batuNew.json';

const AllData = [...PasirData, ...BatuData];
---

<div class='row g-4'>
   {
      AllData &&
         AllData.map((val, idx) => {
            return (
               <div class='col-6 col-md-3'>
                  <Card
                     imgSrc={`/img/${val.image}`}
                     alt={`pasir_${idx}`}
                     gallery='all_gallery'
                     title={val.title}
                     page={val.params.product}
                  />
               </div>
            );
         })
   }
</div>
