//    { title: 'Pasir Bangka - Super (BKS)', imgAlt: 'pasir-bangka-super-bks',  },
//    { title: 'Pasir Bangka - Putih (BKP)', imgAlt: 'pasir-bangka-putih' },
//    { title: 'Pasir Bangka - Belitung Kuning (BB)', imgAlt: 'pasir-belitung-kuning' },
//    { title: 'Pasir Bangka - Belitung (BD)', imgAlt: 'pasir-belitung-bd' },
//    { title: 'Pasir Bangka - Kalimantan Tayan (KA)', imgAlt: 'pasir-kalimantan-tayan' },
//    { title: 'Pasir Bangka - Kalimantan Pulpis (KB)', imgAlt: 'pasir-kalimantan-pulpis' },
//    { title: 'Pasir Bangka - Jambi (BS)', imgAlt: 'pasir-jambi' },
//    { title: 'Pasir Rangkas Kuning', imgAlt: 'pasir-rangkas-kuning' },
//    { title: 'Pasir Rangkas Hitam', imgAlt: 'pasir-rangkas-hitam' },
//    { title: 'Pasir Rangkas Abadi', imgAlt: 'pasir-rangkas-abadi' },
// ];
export const PasirList: CardProps[] = [
   { title: 'Pasir Bangka - Sadai', imgAlt: 'sadai' },
   { title: 'Pasir Bangka - Super', imgAlt: 'super-bks' },
   { title: 'Pasir Bangka - Putih', imgAlt: 'putih-bkp' },
   { title: 'Pasir Bangka - Belitung Kuning', imgAlt: 'belitung-kuning-bb' },
   { title: 'Pasir Bangka - Belitung', imgAlt: 'belitung-bd' },
   { title: 'Pasir Bangka - Kalimantan Tayan', imgAlt: 'kalimantan-tayan-ka' },
   { title: 'Pasir Bangka - Kalimantan Pulpis', imgAlt: 'kalimantan-pulpis-kb' },
   { title: 'Pasir Bangka - Jambi', imgAlt: 'jambi-bs' },
   { title: 'Pasir Rangkas - Kuning', imgAlt: 'rangkas-kuning' },
   { title: 'Pasir Rangkas - Hitam', imgAlt: 'rangkas-hitam' },
   { title: 'Pasir Rangkas - Abadi', imgAlt: 'rangkas-abadi' },
   { title: 'Pasir Cilegon - Ayak', imgAlt: 'cilegon-ayak' },
   { title: 'Pasir Cilegon - Cuci', imgAlt: 'cilegon-cuci' },
];
---

<div class='row g-4'>
   {
      PasirList.map((item) => {
         const type = 'pasir';
         const { title, imgAlt } = item;

         return (
            <div class='col-6 col-md-3'>
               <Card {...{ title, imgAlt, type }} />
            </div>
         );
      })
   }
</div>
