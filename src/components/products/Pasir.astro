---
import Card from './Card.astro';
import PasirData from './../../data/pasirNew.json';
---

<div class='row g-4'>
   {
      PasirData &&
         PasirData.map((val, idx) => {
            return (
               <div class='col-6 col-md-3'>
                  <Card
                     imgSrc={`/img/${val.image}`}
                     alt={`pasir_${idx}`}
                     gallery='pasir_gallery'
                     title={val.title}
                     page={val.params.product}
                  />
               </div>
            );
         })
   }
</div>
