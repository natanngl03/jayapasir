---
import Card, { type CardProps } from './Card.astro';

export const PasirList: CardProps[] = [
   { title: 'Pasir Bangka Super', imgAlt: 'bangka-super' },
   { title: 'Pasir Bangka Putih', imgAlt: 'bangka-putih' },
   { title: 'Pasir Kalimantan Tayan', imgAlt: 'kalimantan-tayan' },
   { title: 'Pasir Jambi', imgAlt: 'jambi' },
   { title: 'Pasir Rangkas Kuning', imgAlt: 'rangkas-kuning' },
   { title: 'Pasir Rangkas Hitam', imgAlt: 'rangkas-hitam' },
   { title: 'Pasir Cilegon Ayak', imgAlt: 'cilegon-ayak' },
   { title: 'Pasir Cilegon Cuci', imgAlt: 'cilegon-cuci' },
];
---

<div class='row g-4'>
   {
      PasirList.map((item) => {
         const type = 'pasir';
         const { title, imgAlt } = item;

         return (
            <div class='col-6 col-md-3'>
               <Card {...{ title, imgAlt, type }} />
            </div>
         );
      })
   }
</div>
