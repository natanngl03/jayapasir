---
import { Image } from 'astro:assets';
import SplitIMG from './../assets/img/armada.png';
import Pasir from './Pasir.astro';
import Batu from './Batu.astro';
import All from './All.astro';
---

<!-- Feature Start -->
<div class='container-fluid py-5 bg-white border-top'>
   <div class='container'>
      <div class='text-center wow fadeIn' data-wow-delay='0.1s'>
         <h1 class='mb-5'>Produk <span class='text-primary px-2'>Kami</span></h1>
      </div>

      <ul class='nav nav-pills mb-5 d-flex align-items-center justify-content-center' id='pills-tab' role='tablist'>
         <li class='nav-item' role='presentation'>
            <button
               class='nav-link active'
               id='pills-home-tab'
               data-bs-toggle='pill'
               data-bs-target='#pills-home'
               type='button'
               role='tab'
               aria-controls='pills-home'
               aria-selected='true'>Pasir</button
            >
         </li>
         <li class='nav-item' role='presentation'>
            <button
               class='nav-link'
               id='pills-profile-tab'
               data-bs-toggle='pill'
               data-bs-target='#pills-profile'
               type='button'
               role='tab'
               aria-controls='pills-profile'
               aria-selected='false'>Batu</button
            >
         </li>
         <li class='nav-item' role='presentation'>
            <button
               class='nav-link'
               id='pills-contact-tab'
               data-bs-toggle='pill'
               data-bs-target='#pills-contact'
               type='button'
               role='tab'
               aria-controls='pills-contact'
               aria-selected='false'>Semua</button
            >
         </li>
      </ul>

      <div class='tab-content' id='pills-tabContent'>
         <div class='tab-pane fade show active' id='pills-home' role='tabpanel' aria-labelledby='pills-home-tab'>
            <Pasir />
         </div>
         <div class='tab-pane fade' id='pills-profile' role='tabpanel' aria-labelledby='pills-profile-tab'>
            <Batu />
         </div>
         <div class='tab-pane fade' id='pills-contact' role='tabpanel' aria-labelledby='pills-contact-tab'>
            <All />
         </div>
      </div>
   </div>
</div>

<!-- Feature End -->

<style>
   .choose {
      width: 100%;
      height: 100%;
      border-radius: 10px;
   }
</style>
