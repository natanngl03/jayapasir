---
import { Image } from 'astro:assets';
import Pasir1IMG from './../../assets/img/pasir1.png';
import Pasir2IMG from './../../assets/img/pasir2.png';
---

<!-- Carousel Start -->
<div class='container-fluid p-0'>
   <div id='header-carousel' class='carousel slide carousel-fade' data-ride='carousel'>
      <div class='carousel-inner'>
         <div class='carousel-item active' style='height: 100dvh;'>
            <Image src={Pasir1IMG} alt='pasir2' class='img-item1' layout='constrained' />

            <div class='carousel-caption d-flex align-items-center justify-content-center'>
               <div style='max-width: 900px;'>
                  <h5 class='text-white text-uppercase mb-md-3'>Pasir Tambang</h5>
                  <h1 class='display-3 text-white mb-md-4'>Supplier pasir kualitas terbaik</h1>
                  <a href='' class='btn btn-primary py-md-2 px-md-4 font-weight-semi-bold mt-2'>Selanjutnya</a>
               </div>
            </div>
         </div>
      </div>
   </div>
</div>
<!-- Carousel End -->

<style>
   .img-item1 {
      object-position: bottom right;
      object-fit: cover;
      width: 100%;
      height: 100%;
   }

   .img-item2 {
      object-position: center;
      object-fit: cover;
      width: 100%;
      height: 100%;
   }
</style>
