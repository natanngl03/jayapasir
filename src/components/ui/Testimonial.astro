---
const testimonials = [
   {
      name: 'Budi Santoso',
      testimoni:
         'Pasirnya bersih, kualitas sesuai pesanan, dan pengiriman selalu tepat waktu. Sangat membantu proyek kami.',
      role: 'Kontraktor',
   },
   {
      name: 'Andi Pratama',
      testimoni: 'Sudah beberapa kali pesan batu split di sini. Kualitas konsisten dan pelayanannya cepat.',
      role: 'Mandor Proyek',
   },
   {
      name: 'Rina Lestari',
      testimoni:
         'Material datang sesuai jumlah pesanan dan kualitas pasirnya bagus untuk pekerjaan plester maupun cor.',
      role: 'Pemilik Rumah',
   },
   {
      name: 'Dedi Saputra',
      testimoni:
         'Supplier yang dapat diandalkan. Pengiriman selalu sesuai jadwal sehingga pekerjaan proyek tidak terlambat.',
      role: 'Developer Perumahan',
   },
];
---

<!-- Testimonial Start -->
<section class='container-fluid bg-light py-5'>
   <div class='container'>
      <h2 class='mb-5 text-center fs-3 fw-bold'>Apa Kata<span class='text-primary px-2'>Mereka ?</span></h2>

      <p class='text-center mb-5'>
         Kepuasan pelanggan adalah prioritas kami. Simak pengalaman mereka menggunakan pasir dan batu berkualitas dari
         Jaya Pasir.
      </p>

      <div class='owl-carousel testimonial-carousel wow fadeIn' data-wow-delay='0.1s'>
         {
            testimonials.map((item, idx) => (
               <div class='testimonial-item'>
                  <div class='testimonial-text position-relative bg-white text-center rounded px-4 py-5'>
                     <i class='fa fa-quote-left fa-2x mb-3' />
                     <p class='mb-0'>{item.testimoni}</p>
                  </div>
                  <div class='text-center pt-4'>
                     {/* <img class='img-fluid rounded mx-auto my-3' src={`/img/testimoni/person-${idx + 1}.webp`} /> */}
                     <i class='fas fa-user img-fluid rounded mx-auto my-3 fa-3x ' />
                     <h5 class='mb-1'>{item.name}</h5>
                     <small>{item.role}</small>
                  </div>
               </div>
            ))
         }
      </div>
   </div>
</section>
<!-- Testimonial End -->

<style is:global>
   /*** Testimonial ***/
   .testimonial-item .testimonial-text i {
      color: var(--bs-primary);
   }

   .testimonial-item .testimonial-text * {
      transition: 0.5s;
   }

   .testimonial-item .testimonial-text::after {
      position: absolute;
      content: '';
      bottom: -29px;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border: 15px solid;
      border-color: var(--bs-light) transparent transparent transparent;
   }

   .testimonial-carousel .owl-item.center .testimonial-item .testimonial-text::after {
      border-color: var(--bs-primary) transparent transparent transparent;
   }

   .testimonial-carousel .owl-item.center .testimonial-item .testimonial-text {
      background: var(--bs-primary) !important;
   }

   .testimonial-carousel .owl-item.center .testimonial-item .testimonial-text * {
      color: #ffffff;
   }

   .testimonial-carousel .owl-item .testimonial-item img {
      width: 75px;
      height: 75px;
   }

   .testimonial-carousel .owl-dots {
      margin-top: 24px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
   }

   .testimonial-carousel .owl-dot {
      position: relative;
      display: inline-block;
      margin: 0 5px;
      width: 15px;
      height: 15px;
      border-radius: 4px;
      border: 1px solid var(--bs-primary);
      transition: 0.5s;
   }

   .testimonial-carousel .owl-dot.active {
      background: var(--bs-primary);
   }

   .fa-user {
      color: var(--bs-gray);
   }
</style>
