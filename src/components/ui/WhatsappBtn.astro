---
import { Icon } from 'astro-icon/components';
---

<a
   class='btn text-white wa-btn'
   href='https://wa.me/6285117436727?text=Hallo%20Jayapasir,%20saya%20ingin%20melakukan%20order.'
   target='_blank'
   rel='noopener noreferrer'
   id='waBtn'
>
   <Icon name='fa6-brands:whatsapp' size={30} />
</a>

<style>
   .wa-btn {
      background-color: var(--bs-teal);
      position: fixed;
      bottom: 40px;
      right: 20px;
      z-index: 99;
      border-radius: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      /* padding: 10px 20px; */
      width: 60px;
      height: 60px;

      /* Mulai di luar layar */
      /* transform: translateX(120%); */

      /* Slide masuk 2 detik, lalu pulse terus */
      /* animation:
         slideInRight 2s ease-out forwards,
         pulse-shadow 2s infinite 2s; */
   }

   @keyframes slideInRight {
      from {
         transform: translateX(120%);
         opacity: 0;
      }

      to {
         transform: translateX(0);
         opacity: 1;
      }
   }

   @keyframes pulse-shadow {
      0% {
         box-shadow: 0 0 0 0 rgba(59, 246, 75, 0.6);
      }

      70% {
         box-shadow: 0 0 0 12px rgba(59, 246, 75, 0);
      }

      100% {
         box-shadow: 0 0 0 0 rgba(59, 246, 75, 0);
      }
   }
</style>
