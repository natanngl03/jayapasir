---
import { Icon } from 'astro-icon/components';
---

<footer class='container-fluid bg-dark text-white'>
   <div class='container'>
      <div class='row g-5'>
         <div class='col-lg-9'>
            <p class='fw-bold text-center fs-3 text-lg-start'>JELUPANG JAYA PASIR</p>
            <p class='text-center text-lg-start m-0'>
               Menghadirkan material pasir dan batu berkualitas terbaik <br /> untuk berbagai kebutuhan konstruksi <br
               />di seluruh wilayah Jabodetabek.
            </p>
         </div>
         <div class='col-lg-3 text-center text-lg-end'>
            <p class='m-0 fw-bold fs-5'>Kontak</p>

            <p class='m-0'>
               <Icon name='fa6-solid:phone' size={15} />

               <span>0851 1743 6727</span>
            </p>

            <p class='m-0'>
               <Icon name='fa6-solid:envelope' size={15} />

               <span>admin@jayapasir.com</span>
            </p>
            <p class='m-0'>
               <Icon name='fa6-solid:location-dot' size={15} />

               <span>Tangerang Selatan, Banten</span>
            </p>
         </div>
      </div>
   </div>

   <p class='text-center m-0 py-3 mt-3 border-top'>
      Copyright © {new Date().getFullYear()} - Made With <Icon name='fa6-solid:heart' size={20} class='text-danger' />
   </p>
</footer>

<style>
   .logo {
      width: 100%;
      max-width: 150px;
   }
</style>
