---
import Youtube from './Youtube.astro';
---

<!-- Feature Start -->
<section class='container-fluid py-5 border-top bg-light' id='chooseUs'>
   <div class='container'>
      <h2 class='mb-5 text-center fs-3 fw-bold'>Video <span class='text-primary px-2'>Gallery</span></h2>

      <div class='row g-3'>
         {
            [
               'KpyQ1dCBmAg',
               '80DgEWi50o8',
               'CCI6gIfaEaU',
               'g0LNyQHTuXE',
               'tXND1MwAqJc',
               'z_U5dxvcymo',
               'Atg7ZpUTdp4',
               '9ESuah39uQ0',
               '34-SRhpT4SQ',
            ].map((val) => (
               <div class='col-md-4'>
                  <Youtube video_id={val} />
               </div>
            ))
         }
      </div>
   </div>
</section>
<!-- Feature End -->

<style>
   #chooseUs {
      scroll-margin-top: 80px;
   }

   .choose {
      width: 100%;
      height: 100%;
      border-radius: 10px;
   }
</style>
