---
// import { BatuList } from '../products/Batu.astro';
// import { PasirList } from '../products/Pasir.astro';
import { Image } from 'astro:assets';
import PasirList from '../../data/pasirNew.json';
import BatuList from '../../data/batuNew.json';
import { Icon } from 'astro-icon/components';

import LogoImg from '../../assets/img/logo24.webp';
---

<div class='container-fluid sticky-top bg-white shadow-sm'>
   <div class='container'>
      <nav class='navbar navbar-expand-lg navbar-light'>
         <a href='/' class='navbar-brand'>
            <img src='/img/new_logo.webp' alt='logo image' class='logo' />

            <!-- <Image src={LogoImg} alt='logo image' layout='constrained' quality='low' loading='lazy' class='logo' /> -->
         </a>
         <button
            type='button'
            class='navbar-toggler'
            data-bs-toggle='collapse'
            data-bs-target='#navbarCollapse'
            aria-label='toggle navigation'
         >
            <span class='navbar-toggler-icon'></span>
         </button>
         <div class='collapse navbar-collapse pb-1 pb-md-0' id='navbarCollapse'>
            <div class='navbar-nav mx-auto p-4 p-lg-0'>
               <a href='/' class='nav-item nav-link custom'>Home</a>
               <a href='/#chooseUs' class='nav-item nav-link custom'>Tentang</a>
               <a href='/#faq' class='nav-item nav-link custom'>Pertanyaan</a>

               <div class='nav-item dropdown'>
                  <a href='#' class='nav-link dropdown-toggle' data-bs-toggle='dropdown'>Harga Pasir</a>
                  <div class='dropdown-menu m-0'>
                     {
                        PasirList.map((val, idx) => (
                           <a href={`/product/${val.params.product}`} class='dropdown-item custom'>
                              {val.title}
                           </a>
                        ))
                     }
                  </div>
               </div>
               <div class='nav-item dropdown'>
                  <a href='#' class='nav-link dropdown-toggle' data-bs-toggle='dropdown'>Harga Batu</a>
                  <div class='dropdown-menu m-0'>
                     {
                        BatuList.map((val, idx) => (
                           <a href={`/product/${val.params.product}`} class='dropdown-item custom'>
                              {val.title}
                           </a>
                        ))
                     }
                  </div>
               </div>
            </div>
            <a
               class='border border-primary text-decoration-none p-2 rounded d-flex align-items-center justify-content-center gap-2'
               href='https://wa.me/6285117436727?text=Hallo%20Jayapasir,%20saya%20ingin%20melakukan%20order.'
               target='_blank'
               rel='noopener noreferrer'
            >
               <Icon name='fa6-brands:whatsapp' size={30} />
               <span> Info: 0851 1743 6727</span>
            </a>
         </div>
      </nav>
   </div>
</div>

<script>
   document.querySelectorAll('.custom').forEach((link) => {
      link.addEventListener('click', () => {
         document.querySelector('.navbar-collapse')?.classList.remove('show');
      });
   });
</script>

<style>
   .logo {
      width: 100%;
      height: 100%;
      max-width: 150px;
      max-height: 95px;
   }
</style>
