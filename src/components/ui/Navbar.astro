---
import PasirList from '../../data/pasirNew.json';
import BatuList from '../../data/batuNew.json';
import { Icon } from 'astro-icon/components';

interface Props {
   page: string;
}

// {
//       "params": { "product": "pasir-bangka" },
//       "title": "Pasir Bangka",
//       "image": "pasir_bangka.webp",
//       "price": {
//          "pickup": "600.000",
//          "engkel": "1.300.000",
//          "truck": "2.700.000"
//       }
//    },

type ProductType = {
   params: { product: string };
};

const { page } = Astro.props;

const pages = [
   { label: 'Beranda', page: 'home' },
   { label: 'Produk', page: 'product' },
   // { label: 'Kontak', page: 'contact' },
   // { label: 'Pertanyaan', page: 'faq' },
];

const others = [
   { label: 'Tentang Kami', page: 'about' },
   { label: 'Pertanyaan', page: 'faq' },
   { label: 'Kontak', page: 'contact' },
];

const isOtherActive = (page: string, list: Array<{ label: string; page: string }>) => {
   return list.some((x) => x.page === page);
};

const isProductActive = (page: string, list: Array<ProductType>) => {
   return list.some((x) => x.params.product === page);
};
---

<nav class='sticky-top bg-white shadow-sm'>
   <div class='container'>
      <div class='navbar navbar-expand-lg navbar-light'>
         <a href='/' class='navbar-brand'>
            <img src='/img/new_logo.webp' alt='logo image' class='logo' />
         </a>
         <button
            type='button'
            class='navbar-toggler'
            data-bs-toggle='collapse'
            data-bs-target='#navbarCollapse'
            aria-label='toggle navigation'
         >
            <span class='navbar-toggler-icon'></span>
         </button>
         <div class='collapse navbar-collapse pb-1 pb-md-0' id='navbarCollapse'>
            <div class='navbar-nav mx-auto p-4 p-lg-0'>
               {
                  pages.map((item) => {
                     const href = item.page === 'home' ? '/' : `/${item.page}`;

                     return (
                        <a
                           href={href}
                           class={`nav-item nav-link custom ${page == item.page && 'fw-bold text-primary'}`}
                        >
                           {item.label}
                        </a>
                     );
                  })
               }

               <div class='nav-item dropdown'>
                  <a
                     href='#'
                     class={`nav-link dropdown-toggle ${isProductActive(page, PasirList) && 'fw-bold text-primary'}`}
                     data-bs-toggle='dropdown'>Harga Pasir</a
                  >
                  <div class='dropdown-menu m-0'>
                     {
                        PasirList.map((val, idx) => (
                           <a
                              href={`/product/${val.params.product}`}
                              class={`dropdown-item custom ${page == val.params.product && 'fw-bold text-primary'}`}
                           >
                              {val.title}
                           </a>
                        ))
                     }
                  </div>
               </div>
               <div class='nav-item dropdown'>
                  <a
                     href='#'
                     class={`nav-link dropdown-toggle ${isProductActive(page, BatuList) && 'fw-bold text-primary'}`}
                     data-bs-toggle='dropdown'>Harga Batu</a
                  >
                  <div class='dropdown-menu m-0'>
                     {
                        BatuList.map((val, idx) => (
                           <a
                              href={`/product/${val.params.product}`}
                              class={`dropdown-item custom ${page == val.params.product && 'fw-bold text-primary'}`}
                           >
                              {val.title}
                           </a>
                        ))
                     }
                  </div>
               </div>

               <div class='nav-item dropdown'>
                  <a
                     href='#'
                     class={`nav-link dropdown-toggle ${isOtherActive(page, others) && 'fw-bold text-primary'}`}
                     data-bs-toggle='dropdown'>Lainnya</a
                  >
                  <div class='dropdown-menu m-0'>
                     {
                        others.map((val, idx) => (
                           <a
                              href={`/${val.page}`}
                              class={`dropdown-item custom ${page == val.page && 'fw-bold text-primary'}`}
                           >
                              {val.label}
                           </a>
                        ))
                     }
                  </div>
               </div>
            </div>
            <a
               class='border border-primary text-decoration-none p-2 rounded d-flex align-items-center justify-content-center gap-2'
               href='https://wa.me/6285117436727?text=Hallo%20Jayapasir,%20saya%20ingin%20melakukan%20order.'
               target='_blank'
               rel='noopener noreferrer'
            >
               <Icon name='fa6-brands:whatsapp' size={30} />
               <span> Info: 0851 1743 6727</span>
            </a>
         </div>
      </div>
   </div>
</nav>

<script>
   document.querySelectorAll('.custom').forEach((link) => {
      link.addEventListener('click', () => {
         document.querySelector('.navbar-collapse')?.classList.remove('show');
      });
   });
</script>

<style>
   .logo {
      width: 100%;
      height: 100%;
      max-width: 150px;
      max-height: 95px;
   }
</style>
