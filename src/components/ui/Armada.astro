---
import { Image } from 'astro:assets';

const armadas = import.meta.glob('../../assets/img/armada/*.webp', {
   eager: true,
   import: 'default',
});
---

<!-- Feature Start -->
<section class='container-fluid py-5 border-top bg-light' id='chooseUs'>
   <div class='container'>
      <h2 class='mb-5 text-center fs-3 fw-bold'>Gallery <span class='text-primary px-2'>Armada</span></h2>

      <div class='row g-3'>
         {
            Object.entries(armadas).map(([path, image], idx) => {
               var imgSrc = image as ImageMetadata;

               return (
                  <div class='col-6 col-md-3'>
                     <a href={imgSrc.src} class='glightbox' data-gallery='gallery-armada'>
                        <Image
                           src={imgSrc}
                           alt={`armada ${idx + 1}`}
                           layout='constrained'
                           style={{
                              width: '100%',
                              height: '100%',
                              borderRadius: '10px',
                           }}
                           quality='low'
                           loading='lazy'
                        />
                     </a>
                  </div>
               );
            })
         }
      </div>
   </div>
</section>
<!-- Feature End -->

<style>
   #chooseUs {
      scroll-margin-top: 80px;
   }
</style>
