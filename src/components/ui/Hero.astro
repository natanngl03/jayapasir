---
import { Image } from 'astro:assets';
import HeroImg from '../../assets/img/pasir.webp';
---

<!-- Header Start -->
<header class='container-fluid p-0'>
   <div id='header-carousel' class='carousel slide' data-bs-ride='carousel'>
      <div class='carousel-inner'>
         <div class='carousel-item active'>
            <!-- <img class='w-100' src='/img/pasir.webp' alt='Image' /> -->

            <Image
               src={HeroImg}
               alt='hero image'
               layout='constrained'
               quality='mid'
               loading='lazy'
               style={{
                  width: '100%',
                  height: '100%',
               }}
            />

            <div class='carousel-caption mt-1'>
               <div class='row h-100 align-items-center justify-content-center'>
                  <div class='col-md-8'>
                     <div class='typingcontainer'>
                        <h1>Supplier Pasir Murah & Batu Murah Berkualitas di Tangerang Selatan</h1>

                        <span id='typed' class='fs-3'></span>
                     </div>

                     <p class='mb-3 mt-3 animated fw-bold slideInDown'>
                        Melayani pengiriman berbagai jenis pasir dan batu bangunan ke seluruh wilayah Jabodetabek dengan
                        armada sendiri, harga kompetitif, dan pengiriman tepat waktu.
                     </p>
                     <div class='d-flex flex-column justify-content-md-center align-items-md-center'>
                        <a
                           href='https://wa.me/6285117436727?text=Hallo%20Jayapasir,%20saya%20ingin%20melakukan%20order.'
                           target='_blank'
                           rel='noopener noreferrer'
                           class='border border-2 border-white text-decoration-none py-2 px-3 mb-3 d-block text-white fs-5 fw-bold rounded'
                           >Info: 0851 1743 6727</a
                        >

                        <button type='button' class='btn btn-primary py-2 px-4 animated slideInDown' id='exploreMore'
                           >Selengkapnya</button
                        >
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>
</header>
<!-- Header End -->

<style>
   .typingcontainer {
      height: 180px;
   }

   .carousel-item {
      position: relative;
   }

   .carousel-item::before {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.35);
      z-index: 1;
   }

   .carousel-caption {
      z-index: 2;
   }

   .typing {
      overflow: hidden;
      white-space: nowrap;
      width: 0;
      animation: typing 3s steps(100, end) forwards;
   }

   @keyframes typing {
      from {
         width: 0;
      }
      to {
         width: 100%;
      }
   }
</style>

<script>
   import Typed from 'typed.js';

   new Typed('#typed', {
      // strings: [
      //    "Penyedia <span class='text-primary'>Pasir &amp; Batu</span> Berkualitas untuk <span class='text-primary'>Jabodetabek</span>",
      // ],
      strings: [
         'Pasir Bangka',
         'Pasir Kalimantan',
         'Pasir Jambi',
         'Pasir Cilegon',
         'Pasir Rangkas',
         'Pasir Jambi',
         'Batu Sirtu',
         'Batu Makadam',
         'Batu Split',
         'Batu Abu',
         'Batu Belah',
      ],
      typeSpeed: 40,
      backSpeed: 30,
      backDelay: 500,
      showCursor: true,
      loop: true,
      contentType: 'html',
   });

   const exploreMore = document.querySelector('#exploreMore');
   if (exploreMore) {
      const navbar = document.querySelector('.navbar') as any;
      if (navbar) {
         const offset = navbar?.offsetHeight;
         const explore = exploreMore as any;
         if (explore) {
            explore?.addEventListener('click', () => {
               scrollToSection('#chooseUs', 80);
            });
         }
      }
   }

   function scrollToSection(selector: string, offset = 0) {
      const element = document.querySelector(selector);

      if (!element) return;

      const top = element.getBoundingClientRect().top + window.pageYOffset - offset;

      window.scrollTo({
         top,
         behavior: 'smooth',
      });
   }
</script>
