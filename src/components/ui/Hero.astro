---
import { Image } from 'astro:assets';
import HeroImg from '../../assets/img/pasir.webp';
---

<!-- Header Start -->
<header>
   <div class='wrapper-hero position-relative'>
      <img src='/img/hero.webp' alt='hero img' style='object-fit: cover;' width='100%' height='100%' loading='eager' />
      <div class='container hero-content'>
         <h1 class='text-center text-white'>
            Supplier Pasir & Batu Murah Berkualitas <br /> di Tangerang Selatan
         </h1>

         <div class='typingcontainer'>
            <p id='typed' class='text-white'></p>
         </div>

         <p class='mb-3 mt-3 fw-bold text-center'>
            Melayani pengiriman berbagai jenis pasir dan batu bangunan ke seluruh wilayah Jabodetabek
         </p>

         <div class='d-flex flex-column justify-content-lg-center align-items-lg-center'>
            <a
               href='https://wa.me/6285117436727?text=Hallo%20Jayapasir,%20saya%20ingin%20melakukan%20order.'
               target='_blank'
               rel='noopener noreferrer'
               class='border border-2 border-white text-decoration-none py-2 px-3 mb-3 d-block text-white fs-5 fw-bold rounded'
               >Info: 0851 1743 6727</a
            >

            <button type='button' class='btn btn-primary py-2 px-4 text-white' id='exploreMore'>Selengkapnya</button>
         </div>
      </div>
   </div>
</header>
<!-- Header End -->

<style>
   .wrapper-hero {
      height: 500px;
   }

   .wrapper-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1;
   }

   .hero-content {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 1;
      color: white;
   }

   .typingcontainer {
      display: flex;
      font-size: calc(1.3rem + 0.6vw) !important;
   }

   @media (min-width: 1200px) {
      .wrapper-hero {
         height: 100dvh;
      }
   }
</style>

<script>
   import Typed from 'typed.js';

   new Typed('#typed', {
      // strings: [
      //    "Penyedia <span class='text-primary'>Pasir &amp; Batu</span> Berkualitas untuk <span class='text-primary'>Jabodetabek</span>",
      // ],
      strings: [
         'Pasir Bangka',
         'Pasir Kalimantan',
         'Pasir Jambi',
         'Pasir Cilegon',
         'Pasir Rangkas',
         'Pasir Jambi',
         'Batu Sirtu',
         'Batu Makadam',
         'Batu Split',
         'Batu Abu',
         'Batu Belah',
      ],
      typeSpeed: 40,
      backSpeed: 30,
      backDelay: 500,
      showCursor: true,
      loop: true,
      contentType: 'html',
   });

   const exploreMore = document.querySelector('#exploreMore');
   if (exploreMore) {
      const navbar = document.querySelector('.navbar') as any;
      if (navbar) {
         const offset = navbar?.offsetHeight;
         const explore = exploreMore as any;
         if (explore) {
            explore?.addEventListener('click', () => {
               scrollToSection('#chooseUs', 80);
            });
         }
      }
   }

   function scrollToSection(selector: string, offset = 0) {
      const element = document.querySelector(selector);

      if (!element) return;

      const top = element.getBoundingClientRect().top + window.pageYOffset - offset;

      window.scrollTo({
         top,
         behavior: 'smooth',
      });
   }
</script>
