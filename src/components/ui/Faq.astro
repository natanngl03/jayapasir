---
import FaqJSON from './../../data/faq.json';

const faq1 = FaqJSON.slice(0, 6);
const faq2 = FaqJSON.slice(6);

interface Props {
   className: string;
}

const { className } = Astro.props;
---

<!-- FAQ Start -->
<section class={className} id='faq'>
   <div class='container'>
      <h2 class='mb-5 text-center fs-3 fw-bold wow fadeInDown' data-wow-delay='0.1s'>
         Yang Sering<span class='text-primary px-2'>Ditanyakan</span>
      </h2>

      <div class='row'>
         <div class='col-lg-6'>
            <div class='accordion' id='accordionFAQ1'>
               {
                  faq1.map((val, idx1) => {
                     const targetId = `faqOne${idx1}`;
                     const targetHeading = `faqOneHeading${idx1}`;
                     const delay = `0.1s`;

                     return (
                        <div class='accordion-item wow fadeInDown' data-wow-delay={delay}>
                           <h2 class='accordion-header' id={targetHeading}>
                              <button
                                 class='accordion-button collapsed border-bottom bg-light'
                                 type='button'
                                 data-bs-toggle='collapse'
                                 data-bs-target={`#${targetId}`}
                                 aria-expanded='false'
                              >
                                 {val.faq}
                              </button>
                           </h2>
                           <div
                              id={targetId}
                              class='accordion-collapse collapse'
                              aria-labelledby={targetHeading}
                              data-bs-parent='#accordionFAQ1'
                           >
                              <div class='accordion-body p-3 bg-light'>
                                 <p class='m-0'>{val.answer.text}</p>

                                 {val.answer.list && val.answer.list.length > 0 && (
                                    <ul>
                                       {val.answer.list.map((val) => (
                                          <li>{val}</li>
                                       ))}
                                    </ul>
                                 )}
                              </div>
                           </div>
                        </div>
                     );
                  })
               }
            </div>
         </div>
         <div class='col-lg-6'>
            <div class='accordion' id='accordionFAQ2'>
               {
                  faq2.map((val, idx2) => {
                     const targetId = `faqTwo${idx2}`;
                     const targetHeading = `faqTwoHeading${idx2}`;
                     const delay = `0.1s`;

                     return (
                        <div class='accordion-item wow fadeInDown' data-wow-delay={delay}>
                           <h2 class='accordion-header' id={targetHeading}>
                              <button
                                 class='accordion-button collapsed border-bottom bg-light'
                                 type='button'
                                 data-bs-toggle='collapse'
                                 data-bs-target={`#${targetId}`}
                                 aria-expanded='false'
                              >
                                 {val.faq}
                              </button>
                           </h2>
                           <div
                              id={targetId}
                              class='accordion-collapse collapse'
                              aria-labelledby={targetHeading}
                              data-bs-parent='#accordionFAQ2'
                           >
                              <div class='accordion-body p-3 bg-light'>
                                 <p class='m-0'>{val.answer.text}</p>

                                 {val.answer.list && val.answer.list.length > 0 && (
                                    <ul>
                                       {val.answer.list.map((val) => (
                                          <li>{val}</li>
                                       ))}
                                    </ul>
                                 )}
                              </div>
                           </div>
                        </div>
                     );
                  })
               }
            </div>
         </div>
      </div>
   </div>
</section>

<!-- FAQ End -->

<style>
   #faq {
      scroll-margin-top: 80px;
   }

   .accordion .accordion-item {
      border: none;
      margin-bottom: 15px;
   }

   .accordion .accordion-button {
      background: var(--light);
      border-radius: 2px;
   }

   .accordion .accordion-button:not(.collapsed) {
      color: #000;
      background: var(--primary);
      box-shadow: none;
   }

   .accordion .accordion-body {
      padding: 15px 0 0 0;
   }
</style>
