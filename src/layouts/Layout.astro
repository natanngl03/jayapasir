---
import 'glightbox/dist/css/glightbox.min.css';
import './../assets/scss/bootstrap.min.css';

// import Navbar from './../components/navbar/index.astro';
import Navbar from './../components/ui/Navbar.astro';
import Footer from './../components/ui/Footer.astro';
import WhatsappBtn from '../components/ui/WhatsappBtn.astro';
---

<!doctype html>
<html lang='en'>
   <head>
      <!-- Basic -->
      <meta charset='UTF-8' />
      <meta name='viewport' content='width=device-width, initial-scale=1.0' />

      <title>Jaya Pasir | Supplier Pasir, Batu Split & Material Bangunan Jabodetabek</title>

      <meta
         name='description'
