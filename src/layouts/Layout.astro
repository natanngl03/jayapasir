      />

      <meta
         name='keywords'
         content='jual pasir, supplier pasir, pasir bangka, pasir putih, pasir kuning, batu split, sirtu, abu batu, material bangunan, Jelupang, Tangerang Selatan, pasir Jelupang, pasir Tangerang Selatan, pasir Jakarta, pasir Bogor, pasir Depok, pasir Tangerang, pasir Bekasi, supplier material Jabodetabek'
      />

      <meta name='author' content='Jaya Pasir' />
      <meta name='robots' content='index, follow' />
      <meta name='theme-color' content='#C79A3B' />

      <!-- Canonical -->
      <link rel='canonical' href='https://jayapasir.com/' />

      <!-- Open Graph -->
      <meta property='og:type' content='website' />
      <meta property='og:site_name' content='Jaya Pasir' />
      <meta property='og:locale' content='id_ID' />
      <meta property='og:url' content='https://jayapasir.com/' />
      <meta property='og:title' content='Jaya Pasir | Supplier Pasir, Batu Split & Material Bangunan Jabodetabek' />
      <meta
         property='og:description'
         content='Supplier pasir, batu split, sirtu, abu batu, dan material bangunan berkualitas. Berlokasi di Jelupang, Kota Tangerang Selatan, melayani pengiriman ke seluruh Jabodetabek.'
      />
      <meta property='og:image' content='https://jayapasir.com/img/og-image.png' />
      <meta property='og:image:type' content='image/png' />
      <meta property='og:image:width' content='1200' />
      <meta property='og:image:height' content='630' />
      <meta property='og:image:alt' content='Jaya Pasir - Supplier Pasir & Material Bangunan Jabodetabek' />

      <!-- X (Twitter) -->
      <meta name='twitter:card' content='summary_large_image' />
      <meta name='twitter:title' content='Jaya Pasir | Supplier Pasir, Batu Split & Material Bangunan Jabodetabek' />
      <meta
         name='twitter:description'
         content='Supplier pasir, batu split, sirtu, abu batu, dan material bangunan berkualitas dari Jelupang, Kota Tangerang Selatan. Melayani seluruh Jabodetabek.'
      />
      <meta name='twitter:image' content='https://jayapasir.com/img/og-image.png' />
      <meta name='twitter:image:alt' content='Jaya Pasir - Supplier Pasir & Material Bangunan Jabodetabek' />

      <!-- Favicon -->
      <link rel='icon' href='/favicon.ico' sizes='any' />
      <link rel='icon' type='image/png' sizes='32x32' href='/favicon-32x32.png' />
      <link rel='icon' type='image/png' sizes='16x16' href='/favicon-16x16.png' />
      <link rel='apple-touch-icon' sizes='180x180' href='/favicon-180x180.png' />
      <link rel='manifest' href='/site.webmanifest' />

      <!-- Google Fonts -->
      <link rel='preconnect' href='https://fonts.googleapis.com' />
      <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
      <link href='https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap' rel='stylesheet' />

      <!-- Font Awesome -->
      <link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css' />

      <!-- Library CSS -->
      <link rel='stylesheet' href='/lib/owlcarousel/assets/owl.carousel.min.css' />

      <!-- Main CSS -->
      <link rel='stylesheet' href='/css/style.css' />
   </head>

   <body>
      <Navbar />
      <slot />
      <Footer />
      <WhatsappBtn />

      <script>
         import 'bootstrap/dist/js/bootstrap.bundle.min.js';

         // import GLightbox from 'glightbox';

         // const lightbox = GLightbox({
         //    selector: '.glightbox',
         // });

         // let isOpen = false;

         // lightbox.on('open', () => {
         //    isOpen = true;
         //    history.pushState({ lightbox: true }, '');
         // });

         // lightbox.on('close', () => {
         //    isOpen = false;
         // });

         // window.addEventListener('popstate', () => {
         //    if (isOpen) {
         //       lightbox.close();
         //    }
         // });

         import GLightbox from 'glightbox';

         const lightbox = GLightbox({
            selector: '.glightbox',
         });

         let isOpen = false;
         let closingFromBack = false;

         lightbox.on('open', () => {
            isOpen = true;
            history.pushState({ lightbox: true }, '');
         });

         lightbox.on('close', () => {
            isOpen = false;

            if (!closingFromBack) {
               history.back();
            }

            closingFromBack = false;
         });

         window.addEventListener('popstate', () => {
            if (isOpen) {
               closingFromBack = true;
               lightbox.close();
            }
         });
      </script>

      <script is:inline src='https://code.jquery.com/jquery-3.4.1.min.js' defer></script>
      <!-- <script is:inline src='https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js' defer></script> -->
      <!-- <script is:inline src='/lib/easing/easing.min.js' defer></script> -->
      <script is:inline src='/lib/owlcarousel/owl.carousel.min.js' defer></script>
      <script is:inline src='/js/main.js' defer></script>
   </body>
</html>
