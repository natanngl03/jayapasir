---
import 'glightbox/dist/css/glightbox.min.css';
import './../assets/scss/bootstrap.min.css';

// import Navbar from './../components/navbar/index.astro';
import Navbar from './../components/ui/Navbar.astro';
import Footer from './../components/ui/Footer.astro';
import WhatsappBtn from '../components/ui/WhatsappBtn.astro';
import Spinner from '../components/ui/Spinner.astro';
---

<!doctype html>
<html lang='en'>
   <head>
      <!-- Basic -->
      <meta charset='UTF-8' />
      <meta name='viewport' content='width=device-width, initial-scale=1.0' />

      <title>Jelupang Jaya Pasir | Supplier Pasir Murah, Batu Split & Material Bangunan Tangerang Selatan</title>

      <meta
         name='description'
         content='Jelupang Jaya Pasir adalah supplier pasir murah, batu murah, batu split, sirtu, abu batu, dan material bangunan di Tangerang Selatan. Melayani pengiriman cepat ke Jakarta, Bogor, Depok, Tangerang, Bekasi, dan seluruh Jabodetabek dengan harga kompetitif.'
      />

      <meta
         name='keywords'
         content='supplier pasir, jual pasir, pasir murah, supplier batu, batu murah, batu split, sirtu, abu batu, pasir bangka, pasir putih, pasir kuning, material bangunan, Tangerang Selatan, Jakarta, Bogor, Depok, Tangerang, Bekasi, Jabodetabek'
      />

      <meta name='author' content='Jelupang Jaya Pasir' />
      <meta name='robots' content='index, follow' />
      <meta name='theme-color' content='#C79A3B' />

      <!-- Canonical -->
      <link rel='canonical' href='https://jayapasir.com/' />

      <!-- Open Graph -->
      <meta property='og:type' content='website' />
      <meta property='og:site_name' content='Jelupang Jaya Pasir' />
      <meta property='og:locale' content='id_ID' />
      <meta property='og:url' content='https://jayapasir.com/' />
      <meta
         property='og:title'
         content='Jelupang Jaya Pasir | Supplier Pasir Murah & Material Bangunan Tangerang Selatan'
      />

      <meta
         property='og:description'
         content='Supplier pasir murah, batu murah, batu split, sirtu, abu batu, dan material bangunan di Tangerang Selatan. Melayani pengiriman ke seluruh Jabodetabek dengan harga kompetitif.'
      />

      <meta property='og:image' content='https://jayapasir.com/img/og-image.png' />
      <meta property='og:image:type' content='image/png' />
      <meta property='og:image:width' content='1200' />
      <meta property='og:image:height' content='630' />
      <meta property='og:image:alt' content='Jelupang Jaya Pasir - Supplier Pasir & Material Bangunan Jabodetabek' />

      <!-- X (Twitter) -->
      <meta name='twitter:card' content='summary_large_image' />
      <meta
         name='twitter:title'
         content='Jelupang Jaya Pasir | Supplier Pasir Murah & Material Bangunan Tangerang Selatan'
      />

      <meta
         name='twitter:description'
         content='Supplier pasir murah, batu murah, batu split, sirtu, abu batu, dan material bangunan di Tangerang Selatan. Melayani pengiriman ke seluruh Jabodetabek.'
      />

      <meta name='twitter:image' content='https://jayapasir.com/img/og-image.png' />
      <meta name='twitter:image:alt' content='Jelupang Jaya Pasir - Supplier Pasir & Material Bangunan Jabodetabek' />

      <!-- Favicon -->
      <link rel='icon' href='/favicon.ico' sizes='any' />
      <link rel='icon' type='image/png' sizes='32x32' href='/favicon-32x32.png' />
      <link rel='icon' type='image/png' sizes='16x16' href='/favicon-16x16.png' />
      <link rel='apple-touch-icon' sizes='180x180' href='/favicon-180x180.png' />
      <link rel='manifest' href='/site.webmanifest' />

      <!-- Google tag (gtag.js) -->
      <script async src='https://www.googletagmanager.com/gtag/js?id=AW-18350103200'></script>
      <script src='/js/analytics.js' is:inline></script>

      <!-- Google Fonts -->
      <link rel='preconnect' href='https://fonts.googleapis.com' />
      <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
      <link
         href='https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap'
         rel='stylesheet'
      />

      <!-- Library CSS -->
      <link rel='stylesheet' href='/lib/owlcarousel/assets/owl.carousel.min.css' />

      <!-- Main CSS -->
      <link rel='stylesheet' href='/css/style.css' />
   </head>

   <body>
      <!-- Spinner Start -->
      <Spinner />

      <!-- <div id="spi" style='position: fixed; inset: 0; background: #FFF; z-index: 99999;' class='d-flex hidden'>
         <div class='spinner-border text-primary m-auto' role='status'>
            <span class='visually-hidden'>Loading...</span>
         </div>
      </div> -->
      <!-- Spinner End -->

      <Navbar />
      <main>
         <slot />
      </main>

      <WhatsappBtn />
      <Footer />

      <script>
         import 'bootstrap/dist/js/bootstrap.bundle.min.js';

         import GLightbox from 'glightbox';

         const lightbox = GLightbox({
            selector: '.glightbox',
         });

         let isOpen = false;
         let closingFromBack = false;

         lightbox.on('open', () => {
            isOpen = true;
            history.pushState({ lightbox: true }, '');
         });

         lightbox.on('close', () => {
            isOpen = false;

            if (!closingFromBack) {
               history.back();
            }

            closingFromBack = false;
         });

         window.addEventListener('popstate', () => {
            if (isOpen) {
               closingFromBack = true;
               lightbox.close();
            }
         });
      </script>

      <script is:inline src='https://code.jquery.com/jquery-3.4.1.min.js' defer></script>
      <script is:inline src='/lib/owlcarousel/owl.carousel.min.js' defer></script>
      <script is:inline src='/js/main.js' defer></script>
   </body>
</html>
