---
import Layout from './../layouts/Layout.astro';
import ChooseUs from './../components/ui/ChooseUs.astro';
import Products from './../components/products/Products.astro';
import Faq from './../components/ui/Faq.astro';
import Hero from './../components/ui/Hero.astro';
import Divider from '../components/ui/Divider.astro';
import Testimonial from '../components/ui/Testimonial.astro';
import Location from '../components/ui/Location.astro';
---

<Layout
   page='home'
   title='Jelupang Jaya Pasir | Supplier Pasir Dan Batu Murah di Tangerang Selatan Pengiriman Jabodetabek'
   description='Jelupang Jaya Pasir Adalah Supplier Pasir Dan Batu Dengan Harga Murah, Kualitas Terbaik di Tangerang Selatan. Kami Melayani Pengiriman Se Jabodetabek Dan Pengiriman Cepat'
>
   <Hero />
   <ChooseUs className='py-5 bg-light' />
   <Products className='py-5 bg-white border-top' />
   <!-- <Video /> -->
   <!-- <Armada /> -->
   <Divider />
   <Faq className='py-5 border-top border-bottom' />
   <Testimonial />
   <Location />
</Layout>
