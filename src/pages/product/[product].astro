---
import { Image } from 'astro:assets';
import Layout from './../../layouts/Layout.astro';
import PasirJson from './../../data/pasir.json';
import BatuJson from './../../data/batu.json';

const { product } = Astro.params;

export const PasirData = PasirJson as ProductType[];
export const BatuData = BatuJson as ProductType[];

export const AllData = [...PasirData, ...BatuData];

export function getStaticPaths() {
   return AllData;
}

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/products/*.{jpg,jpeg,png,webp}', {
   eager: true,
});

function getImage(name: string) {
   return images[`../../assets/img/products/${name}`]?.default;
}

const getProduct = () => {
   const item = AllData.find((item) => item.params.product == product);
   if (!item) return undefined;

   return item;
};

const item = getProduct();

const image = getImage(item?.image || '');
---

<Layout>
   <div class='container-fluid header'>
      <div class='container'>
         <div class='row g-4'>
            <div class='col-md-5 order-2 order-md-1'>
               <Image
                  src={image}
                  alt={item?.params?.product || 'material image'}
                  layout='constrained'
                  style={{
                     width: '100%',
                     height: '100%',
                     borderRadius: '10px',
                  }}
                  quality='low'
                  loading='lazy'
               />
            </div>
            <div class='col-md-7 order-1 order-md-2'>
               <h1 class='text-center mt-5 mb-3 upper'>
                  {item?.title || 'Material'} - Harga {new Date().getFullYear()}
               </h1>

               <div class='overflow-auto mb-3'>
                  <table class='table table-striped table-bordered'>
                     <thead>
                        <tr>
                           <th scope='col'>Angkutan</th>
                           <th scope='col'>Harga (Jabodetabek)</th>
                        </tr>
                     </thead>
                     <tbody>
                        <tr>
                           <th scope='row'>Truk (5.5 kubik)</th>
                           <td>Rp {item?.price?.truck || '-'}</td>
                        </tr>
                        <tr>
                           <th scope='row'>Engkel (2.5 kubik) <i>*hanya tangsel</i></th>
                           <td
                              >{
                                 item?.price?.engkel === 'callus' ? (
                                    <i>hubungi kami</i>
                                 ) : item?.price?.engkel === 'unavailable' ? (
                                    <i>tidak tersedia</i>
                                 ) : (
                                    `Rp ${item?.price?.engkel}`
                                 )
                              }</td
                           >
                        </tr>
                        <tr>
                           <th scope='row'>Pickup (1.0 kubik) <i>*hanya tangsel</i></th>

                           <td
                              >{
                                 item?.price?.pickup === 'callus' ? (
                                    <i>hubungi kami</i>
                                 ) : item?.price?.pickup === 'unavailable' ? (
                                    <i>tidak tersedia</i>
                                 ) : (
                                    `Rp ${item?.price?.pickup}`
                                 )
                              }</td
                           >
                        </tr>
                     </tbody>
                  </table>
               </div>

               <p class='m-0'>Notes:</p>
               <ul class='fst-italic text-gray'>
                  <li>Harga final akan dihitung ulang sesuai lokasi anda</li>
                  <li>Selalu tanyakan ketersedian barang & harga terbaru karena dapat berubah sewaktu-waktu.</li>
               </ul>

               <a
                  href={`https://wa.me/6285117436727?text=Hallo%20Jayapasir,%20saya%20ingin%20melakukan%20order%20${item?.title}`}
                  class='btn btn-primary d-flex justify-content-center align-items-center gap-2 text-white py-3 py-md-2'
               >
                  <i class='fab fa-whatsapp fa-2x'></i>
                  <span> Pesan Sekarang </span></a
               >
            </div>
         </div>
      </div>
   </div>

   <style>
      .header {
         padding: 100px 0 0 0;
      }

      .upper {
         text-transform: uppercase;
      }
   </style>
</Layout>
