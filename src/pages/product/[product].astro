---
import Layout from './../../layouts/Layout.astro';
import Json from './_data.json';

export function getStaticPaths() {
   const Pasir = [
      { params: { product: 'sadai' } },
      { params: { product: 'super-bks' } },
      { params: { product: 'putih-bkp' } },
      { params: { product: 'belitung-kuning-bb' } },
      { params: { product: 'belitung-bd' } },
      { params: { product: 'kalimantan-tayan-ka' } },
      { params: { product: 'kalimantan-pulpis-kb' } },
      { params: { product: 'jambi-bs' } },
      { params: { product: 'cilegon-ayak' } },
      { params: { product: 'cilegon-cuci' } },
      { params: { product: 'rangkas-hitam' } },
      { params: { product: 'rangkas-kuning' } },
      { params: { product: 'rangkas-abadi' } },
   ];

   const Batu = [
      { params: { product: 'batu-split' } },
      { params: { product: 'batu-belah' } },
      { params: { product: 'batu-makadam' } },
      { params: { product: 'batu-sirtu' } },
      { params: { product: 'batu-abu' } },
   ];

   return [...Pasir, ...Batu];
}

const { product } = Astro.params;

const jsonData = Json as any;

const data = jsonData[product];

const productType = () => {
   let title = '';

   if (product.includes('rangkas-') || product.includes('cilegon-')) {
      title = `pasir ${product.replaceAll('-', ' ')}`;
   } else if (product.includes('batu-')) {
      title = product.replaceAll('-', ' ');
   } else {
      const arr = product.split('-');
      const newArr = arr.length == 1 ? arr : arr.slice(0, -1);
      title = `pasir bangka - ${newArr.join(' ')}`;
   }

   return title;
};

const productName = productType();
---

<Layout>
   <div class='container-fluid bg-secondary header'>
      <h2 class='text-center py-5 text-uppercase px-2'>{productName}</h2>
   </div>
   <div class='container-fluid'>
      <div class='container'>
         <div class='row'>
            <div class='col-md-2'></div>
            <div class='col-md-8'>
               <h4 class='text-center mt-5 mb-3'>Harga</h4>

               <div class='overflow-auto mb-3'>
                  <table class='table table-striped table-bordered'>
                     <thead>
                        <tr>
                           <th scope='col'>Angkutan</th>
                           <th scope='col'>Harga (Jabodetabek)</th>
                        </tr>
                     </thead>
                     <tbody>
                        <tr>
                           <th scope='row'>Truk 5.5 m3 (kubik)</th>
                           <td>Rp {data['truk']}</td>
                        </tr>
                        <tr>
                           <th scope='row'>Engkel 2.5 m3 (kubik)</th>
                           <td>Rp {data['engkel']}</td>
                        </tr>
                        <tr>
                           <th scope='row'>Pickup</th>
                           <td>Rp {data['pickup']}</td>
                        </tr>
                     </tbody>
                  </table>
               </div>

               <p class='m-0'>Notes:</p>
               <ul class='fst-italic text-gray'>
                  <li>Harga diatas hanya acuan</li>
                  <li>Harga final akan dihitung ulang sesuai lokasi anda</li>
                  <li>Harga final sudah FREE ONGKIR</li>
                  <li>Selalu tanyakan ketersedian barang & harga terbaru</li>
               </ul>

               <a href='' class='btn btn-primary d-flex justify-content-center align-items-center gap-2 text-white py-3 py-md-2'>
                  <i class='fab fa-whatsapp fa-2x'></i>
                  <span> Pesan Sekarang </span></a
               >
            </div>
            <div class='col-md-2'></div>
         </div>
      </div>
   </div>

   <style>
      .header {
         padding: 100px 0 0 0;
      }
   </style>
</Layout>
