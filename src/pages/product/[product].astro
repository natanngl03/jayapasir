---
import { Image } from 'astro:assets';
import Layout from './../../layouts/Layout.astro';
import PasirJson from './../../data/pasirNew.json';
import BatuJson from './../../data/batuNew.json';
import { Icon } from 'astro-icon/components';
import Price from '../../components/products/Price.astro';

const { product } = Astro.params;

// export const PasirData = PasirJson as ProductType[];
// export const BatuData = BatuJson as ProductType[];

// export const AllData = [...PasirJson, ...BatuData];
export const AllData = [...PasirJson, ...BatuJson];

export function getStaticPaths() {
   return AllData;
}

// const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/products/*.{jpg,jpeg,png,webp}', {
//    eager: true,
// });

// function getImage(name: string) {
//    return images[`../../assets/img/products/${name}`]?.default;
// }

const getProduct = () => {
   const item = AllData.find((item) => item.params.product == product);
   if (!item) return undefined;

   return item;
};

const item = getProduct();

// const image = getImage(item?.image || '');
---

<Layout>
   <div class='container-fluid pt-5 pb-10'>
      <div class='container'>
         <h1 class='text-center display-6 mb-5 fw-bold'>
            {`Harga ${new Date().getFullYear()} - ${item?.title}`}
         </h1>
         <div class='row g-4'>
            <div class='col-lg-5'>
               <img
                  src={`/img/${item?.image}`}
                  alt={item?.title}
                  width='100%'
                  height='100%'
                  loading='lazy'
                  style='border-radius: 10px;'
               />
            </div>
            <div class='col-lg-7'>
               <div class='d-flex flex-column gap-3'>
                  {
                     item?.title?.toLowerCase() !== 'pasir karungan' ? (
                        <Fragment>
                           {item?.price?.pickup && <Price title='1 Pickup - 1.1 Kubik' price={item?.price?.pickup} />}
                           {item?.price?.engkel && <Price title='1 Engkel - 2.7 Kubik' price={item?.price?.engkel} />}
                           {item?.price?.truck && <Price title='1 Truk - 6 Kubik' price={item?.price?.truck} />}
                        </Fragment>
                     ) : (
                        <Price title='Per Karung - Mulai Dari' price={'20.000'} />
                     )
                  }
               </div>

               <div class='my-3'>
                  <p class='mb-2 fw-bold fs-2'>Catatan:</p>
                  <ul class='fst-italic text-gray d-flex flex-column gap-2'>
                     <li>Harga sudah <span class='fw-bold'>FREE Ongkir</span></li>
                     <li>Harga diatas untuk wilayah <span class='fw-bold'>Tangerang Selatan & Sekitarnya</span></li>
                     <li>
                        Harga&nbsp;<span class='fw-bold'>diluar wilayah itu (JABODETABEK)</span>&nbsp;silahkan hubungi
                        kami
                     </li>
                     <li>
                        Pembelian menggunakan <span class='fw-bold'>Engkel & Pickup</span> hanya untuk wilayah Tangerang Selatan
                        & Sekitarnya
                     </li>
                     <li>
                        <span class='fw-bold'>Selalu tanyakan</span> ketersedian barang & harga terbaru karena dapat berubah
                        sewaktu-waktu.
                     </li>
                  </ul>

                  <p class='fw-bold fs-3 mt-2'>***Barang yang tidak tercantum harap tanyakan ke kami</p>
               </div>

               <a
                  href={`https://wa.me/6285117436727?text=Hallo%20Jayapasir,%20saya%20ingin%20melakukan%20order%20${item?.title}`}
                  class='btn btn-primary d-flex justify-content-center align-items-center gap-2 text-white'
               >
                  <Icon name='fa6-brands:whatsapp' size={30} />
                  <span>Pesan Sekarang</span></a
               >
            </div>
         </div>
      </div>
   </div>
</Layout>
