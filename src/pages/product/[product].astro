---
import Layout from './../../layouts/Layout.astro';
import PasirJson from './../../data/pasir.json';
import BatuJson from './../../data/batu.json';

export function getStaticPaths() {
   const Pasir = [
      { params: { product: 'bangka-super' } },
      { params: { product: 'bangka-putih' } },
      { params: { product: 'kalimantan-tayan' } },
      { params: { product: 'jambi' } },
      { params: { product: 'rangkas-kuning' } },
      { params: { product: 'rangkas-hitam' } },
      { params: { product: 'cilegon-ayak' } },
      { params: { product: 'cilegon-cuci' } },
   ];

   const Batu = [
      { params: { product: 'batu-abu' } },
      { params: { product: 'batu-belah' } },
      { params: { product: 'batu-beskos' } },
      { params: { product: 'batu-brangkal-hs' } },
      { params: { product: 'batu-kuricak' } },
      { params: { product: 'batu-makadam' } },
      { params: { product: 'batu-sekrining' } },
      { params: { product: 'batu-sirtu' } },
      { params: { product: 'batu-split-ancol' } },
   ];

   return [...Pasir, ...Batu];
}

const { product } = Astro.params;

const jsonObj = { ...PasirJson, ...BatuJson };
const jsonData = jsonObj as any;

const data = jsonData[product];

const productType = () => {
   let title = '';

   if (product.includes('batu-')) {
      title = product.replaceAll('-', ' ');
   } else {
      title = `pasir ${product.replaceAll('-', ' ')}`;
   }

   return title;
};

const productName = productType();
---

<Layout>
   <div class='container-fluid bg-primary header'>
      <h2 class='text-center py-5 text-uppercase px-2'>{productName}</h2>
   </div>
   <div class='container-fluid'>
      <div class='container'>
         <div class='row'>
            <div class='col-md-2'></div>
            <div class='col-md-8'>
               <h4 class='text-center mt-5 mb-3'>Harga {new Date().getFullYear()}</h4>

               <div class='overflow-auto mb-3'>
                  <table class='table table-striped table-bordered'>
                     <thead>
                        <tr>
                           <th scope='col'>Angkutan</th>
                           <th scope='col'>Harga (Jabodetabek)</th>
                        </tr>
                     </thead>
                     <tbody>
                        <tr>
                           <th scope='row'>Truk (5,5 kubik)</th>
                           <td>Rp {data['truk']}</td>
                        </tr>
                        <tr>
                           <th scope='row'>Engkel (2,5 kubik)</th>
                           <td>Rp {data['engkel']}</td>
                        </tr>
                        <tr>
                           <th scope='row'>Pickup (1,0 kubik) <i>*hanya tangsel</i></th>
                           <td>Rp {data['pickup']}</td>
                        </tr>
                     </tbody>
                  </table>
               </div>

               <p class='m-0'>Notes:</p>
               <ul class='fst-italic text-gray'>
                  <li>Harga diatas hanya acuan Tangsel</li>
                  <li>Harga final akan dihitung ulang sesuai lokasi anda</li>
                  <li>Harga final sudah FREE ONGKIR</li>
                  <li>Selalu tanyakan ketersedian barang & harga terbaru</li>
               </ul>

               <a href='' class='btn btn-primary d-flex justify-content-center align-items-center gap-2 text-white py-3 py-md-2'>
                  <i class='fab fa-whatsapp fa-2x'></i>
                  <span> Pesan Sekarang </span></a
               >
            </div>
            <div class='col-md-2'></div>
         </div>
      </div>
   </div>

   <style>
      .header {
         padding: 100px 0 0 0;
      }
   </style>
</Layout>
