---
import { Image } from 'astro:assets';
import Layout from './../../layouts/Layout.astro';
import PasirJson from './../../data/pasirNew.json';
import BatuJson from './../../data/batuNew.json';

const { product } = Astro.params;

// export const PasirData = PasirJson as ProductType[];
// export const BatuData = BatuJson as ProductType[];

// export const AllData = [...PasirJson, ...BatuData];
export const AllData = [...PasirJson, ...BatuJson];

export function getStaticPaths() {
   return AllData;
}

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/products/*.{jpg,jpeg,png,webp}', {
   eager: true,
});

function getImage(name: string) {
   return images[`../../assets/img/products/${name}`]?.default;
}

const getProduct = () => {
   const item = AllData.find((item) => item.params.product == product);
   if (!item) return undefined;

   return item;
};

const item = getProduct();

const image = getImage(item?.image || '');
---

<Layout>
   <div class='container-fluid py-10'>
      <div class='container'>
         <h1 class='text-center display-6 mb-5 fw-bold'>
            {`Harga ${new Date().getFullYear()} - ${item?.title}`}
         </h1>
         <div class='row g-4'>
            <div class='col-lg-5 order-2 order-lg-1'>
               <Image
                  src={image}
                  alt={item?.params?.product || 'material image'}
                  layout='constrained'
                  style={{
                     width: '100%',
                     height: '100%',
                     borderRadius: '10px',
                  }}
                  quality='low'
                  loading='lazy'
               />
            </div>
            <div class='col-lg-7 order-1 order-lg-2'>
               <div
                  class='container border border-2 border-primary rounded d-flex flex-column justify-content-between py-3'
               >
                  <h2 class='text-center fs-4 fw-light border-bottom border-primary border-2 pb-3'>
                     Ukuran 1 Dumptruck 6 m3 <br />
                     <span class='fst-italic fw-bold fs-6'>FREE ONGKIR</span>
                  </h2>

                  <h3 class='text-center my-5 text-danger fs-1 fw-bold'>Rp {item?.price}</h3>

                  <a
                     href={`https://wa.me/6285117436727?text=Hallo%20Jayapasir,%20saya%20ingin%20melakukan%20order%20${item?.title}`}
                     class='btn btn-primary d-flex justify-content-center align-items-center gap-2 text-white'
                  >
                     <i class='fab fa-whatsapp fa-2x'></i>
                     <span>Pesan Sekarang</span></a
                  >
               </div>

               <div class='mt-3'>
                  <p class='mb-2 fw-bold fs-2'>Catatan:</p>
                  <ul class='fst-italic text-gray d-flex flex-column gap-2'>
                     <li>Harga sudah <span class='fw-bold'>FREE Ongkir</span></li>
                     <li>Untuk <span class='fw-bold'>NEGO</span>&nbsp;harga silakan hubungi kami</li>
                     <li>Harga diatas untuk wilayah <span class='fw-bold'>Tangerang & Jakarta Selatan</span></li>
                     <li>Harga&nbsp;<span class='fw-bold'>diluar wilayah itu</span>&nbsp;silakan hubungi kami</li>
                     <li>
                        Pembelian menggunakan <span class='fw-bold'>Engkel & Pickup</span> hanya untuk wilayah Tangerang,
                        untuk harga silakan hubungi kami
                     </li>
                     <li>
                        <span class='fw-bold'>Selalu tanyakan</span> ketersedian barang & harga terbaru karena dapat berubah
                        sewaktu-waktu.
                     </li>
                  </ul>

                  <p class='fw-bold fs-3 mt-2'>***Barang yang tidak tercantum harap tanyakan ke kami</p>
               </div>
            </div>
         </div>
      </div>
   </div>
</Layout>
