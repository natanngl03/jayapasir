---
import Layout from './../../layouts/Layout.astro';
import Json from './_data.json';

export function getStaticPaths() {
   const Pasir = [
      { params: { product: 'pasir-bangka-putih' } },
      { params: { product: 'pasir-bangka-kuning' } },
      { params: { product: 'pasir-bangka-sadai' } },
      { params: { product: 'pasir-bangka-jambi' } },
      { params: { product: 'pasir-rangkas-kuning' } },
      { params: { product: 'pasir-rangkas-hitam' } },
      { params: { product: 'pasir-rangkas-abadi' } },
      { params: { product: 'pasir-cilegon-ayak' } },
      { params: { product: 'pasir-cilegon-cuci' } },
      { params: { product: 'pasir-urug' } },
   ];

   const Batu = [
      { params: { product: 'batu-split' } },
      { params: { product: 'batu-belah' } },
      { params: { product: 'batu-makadam' } },
      { params: { product: 'batu-sirtu' } },
      { params: { product: 'batu-abu' } },
   ];

   return [...Pasir, ...Batu];
}

const { product } = Astro.params;

const jsonData = Json as any;

const data = jsonData[product];

const { deskripsi, ...ongkir } = data;

console.log('ONKIR : ', ongkir);

const imgSrc = product.includes('batu-') ? `/img/batu/${product}.webp` : `/img/pasir/${product}.webp`;
---

<Layout>
   <div class='container-fluid bg-secondary header'>
      <h2 class='text-center py-5 text-uppercase'>{product.replaceAll('-', ' ')}</h2>
   </div>
   <div class='container-fluid'>
      <div class='container'>
         <div class='row mt-3 mt-md-5 g-5'>
            <div class='col-md-6'>
               <img src={imgSrc} alt={product} width='100%' class='img-product' />
            </div>
            <div class='col-md-6 d-flex flex-column'>
               <p>
                  {data?.deskripsi || 'no content'}
               </p>

               <h4 class='text-center mt-5 mb-3'>Harga {product.replaceAll('-', ' ')}</h4>

               <div class='overflow-auto mb-3'>
                  <table class='table table-striped table-bordered'>
                     <thead>
                        <tr>
                           <th scope='col'>Angkutan</th>
                           <th scope='col'>Jakarta</th>
                           <th scope='col'>Bogor</th>
                           <th scope='col'>Depok</th>
                           <th scope='col'>Tangerang</th>
                           <th scope='col'>Bekasi</th>
                        </tr>
                     </thead>
                     <tbody>
                        <tr>
                           <th scope='row'>Truk 6m3</th>
                           {
                              ongkir['truk'] &&
                                 Object.entries(ongkir['truk']).map(([key, value]) => {
                                    return <td>{value}</td>;
                                 })
                           }
                        </tr>
                        <tr>
                           <th scope='row'>Engkel</th>
                           {
                              ongkir['engkel'] &&
                                 Object.entries(ongkir['engkel']).map(([key, value]) => {
                                    return <td>{value}</td>;
                                 })
                           }
                        </tr>
                        <tr>
                           <th scope='row'>Pickup</th>
                           {
                              ongkir['pickup']
                                 ? Object.entries(ongkir['pickup']).map(([key, value]) => {
                                      return <td>{value}</td>;
                                   })
                                 : [...Array(5)].map(() => <td>-</td>)
                           }
                        </tr>
                     </tbody>
                  </table>
               </div>

               <p class='m-0'>Notes:</p>
               <ul class='fst-italic text-gray'>
                  <li>Harga diatas sudah FREE ONGKIR</li>
                  <li>Harga dapat berubah sewaktu-waktu</li>
                  <li>Selalu tanyakan ketersedian barang & harga terbaru</li>
               </ul>

               <a href='' class='btn btn-primary d-flex justify-content-center align-items-center gap-2 text-white py-3 py-md-2'>
                  <i class='fab fa-whatsapp fa-2x'></i>
                  <span> Pesan Sekarang </span></a
               >
            </div>
         </div>
      </div>
   </div>
</Layout>

<style>
   .header {
      padding: 100px 0 0 0;
   }

   .img-product {
      border-radius: 20px;
   }
</style>
